# Ratatoskr — optional environment (copy to .env)
#
# Local dev: you can leave this file empty or copy with defaults below.
# Honeypot / LLM vars are only needed for the optional honeypot subproject.

# --- Control API (optional; start with: ratatoskr api start) ---
# RATATOSKR_API_HOST=127.0.0.1
# RATATOSKR_API_PORT=8090
# Local dev: leave RATATOSKR_API_KEY unset (all routes open).
# RATATOSKR_API_KEY=

# --- Flink REST (API + CLI read JobManager on the host) ---
# Minimal stack (ratatoskr up): host port 8082 — default when RATATOSKR_PROFILE=minimal
# Honeypot stack (ratatoskr up --profile full): host port 8081
# FLINK_REST_ADDRESS=localhost
# FLINK_REST_PORT=8082

# --- Compose ---
# FLINK_AGENT_IMAGE=agent_flink_image:latest
# RATATOSKR_PROFILE=minimal

# --- Studio Kafka (ratatoskr kafka up — independent of honeypot) ---
# Host port 9094 (honeypot Kafka uses 9093 when running ratatoskr up --profile full)
# KAFKA_BOOTSTRAP_SERVERS=localhost:9094
# Kafka monitor / heal (workflow_kafka_monitor)
# KAFKA_CATALOG=studio
# KAFKA_HEAL_PHASE=monitor
# KAFKA_HEAL_DRY_RUN=0
# KAFKA_HEAL_VERIFY=1
# KAFKA_HEAL_COOLDOWN_SEC=0
# KAFKA_HEAL_MAX_MUTATIONS=0
# KAFKA_HEAL_ALLOW_TOPICS=
# KAFKA_HEAL_ALLOW_GROUPS=
# KAFKA_HEAL_ALLOW_NAME_REGEX=

# Continuous monitor queries (ratatoskr monitor start / --continuous)
# MONITOR_MODE=oneshot
# MONITOR_INTERVAL_SEC=10
# NIFI_MONITOR_POLLS=5
# KAFKA_MONITOR_POLLS=5
# NIFI_MONITOR_POLL_TOPIC=nifi.monitor.poll
# KAFKA_MONITOR_POLL_TOPIC=kafka.monitor.poll
# KAFKA_LAG_WARN=1000
# KAFKA_LAG_CRIT=10000
# KAFKA_PROBE_SLOW_MS=3000
# KAFKA_WATCH_PREFIXES=
# KAFKA_FLAG_UNEXPECTED=0
# KAFKA_TOPIC_PARTITIONS=1
# KAFKA_TOPIC_RF=1

# --- Workflow API fetch agent (workflow_api_fetch; or configure in dashboard Settings) ---
# RATATOSKR_API_FETCH_ENDPOINT_URL=https://jsonplaceholder.typicode.com/
# RATATOSKR_API_FETCH_HTTP_METHOD=GET
# RATATOSKR_API_FETCH_API_KEY=
# RATATOSKR_API_FETCH_AUTH_HEADER=Authorization
# RATATOSKR_API_FETCH_AUTH_PREFIX=Bearer
# RATATOSKR_API_FETCH_TIMEOUT_SECONDS=15

# --- ReAct LLM (Designer / dashboard Settings; optional env fallback) ---
# Prefer Designer Settings; env used when store fields are empty.
# Example (Cloudera AI Inference / OpenAI-compatible):
# RATATOSKR_LLM_ENDPOINT_URL=https://ml-….cloudera.site/namespaces/serving-default/endpoints/<name>/v1
# RATATOSKR_LLM_MODEL_ID=nvidia/nemotron-3-super-120b-a12b
# RATATOSKR_LLM_API_KEY=          # CDP JWT / API key
# Aliases: CLOUDERA_AI_BASE_URL, CLOUDERA_MODEL_ID, CLOUDERA_JWT_TOKEN

# --- Honeypot only (ratatoskr up --profile full) ---
# CLOUDERA_AI_BASE_URL=
# CLOUDERA_JWT_TOKEN=
# CLOUDERA_MODEL_ID=
# --- NiFi monitoring lab (ratatoskr up --profile nifi) ---
# NIFI_API_BASE=https://localhost:8443/nifi-api
# NIFI_USERNAME=admin
# NIFI_PASSWORD=RatatoskrNiFi1!
# NIFI_HTTPS_PORT=8443
# NIFI_VERIFY_SSL=false
# Heal phase: monitor | safe | lab
# NIFI_HEAL_PHASE=monitor
# Lab-only destructive queue drain (requires NIFI_HEAL_PHASE=lab)
# NIFI_HEAL_ALLOW_EMPTY_QUEUE=0
# NIFI_HEAL_DRY_RUN=0
# NIFI_HEAL_VERIFY=1
# NIFI_HEAL_COOLDOWN_SEC=0
# NIFI_HEAL_MAX_MUTATIONS=0
# NIFI_HEAL_ALLOW_IDS=
# NIFI_HEAL_ALLOW_NAME_REGEX=
# NIFI_BP_WARN=1
# NIFI_BP_CRIT=100
# NIFI_EMPTY_QUEUE_MIN_FLOWFILES=1
# NIFI_PROBE_SLOW_MS=5000
# NIFI_WATCH_NAME_REGEX=
# NIFI_WATCH_ID_REGEX=
# CDP / NiFi-MCP-Server (Phase 2A — Knox; not required for local Docker)
# KNOX_TOKEN=
