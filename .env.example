# Ratatoskr — optional environment (copy to .env)
#
# Local dev: you can leave this file empty or copy with defaults below.
# Honeypot / LLM vars are only needed for the optional honeypot subproject.

# --- Control API (optional; start with: ratatoskr api start) ---
# RATATOSKR_API_HOST=127.0.0.1
# RATATOSKR_API_PORT=8090
# Local dev: leave RATATOSKR_API_KEY unset (all routes open).
# RATATOSKR_API_KEY=

# --- Flink REST (API + CLI read JobManager on the host) ---
# Minimal stack (ratatoskr up): host port 8082 — default when RATATOSKR_PROFILE=minimal
# Honeypot stack (ratatoskr up --profile full): host port 8081
# FLINK_REST_ADDRESS=localhost
# FLINK_REST_PORT=8082

# --- Compose ---
# FLINK_AGENT_IMAGE=agent_flink_image:latest
# RATATOSKR_PROFILE=minimal

# --- Studio Kafka (ratatoskr kafka up — independent of honeypot) ---
# Host port 9094 (honeypot Kafka uses 9093 when running ratatoskr up --profile full)
# KAFKA_BOOTSTRAP_SERVERS=localhost:9094

# --- Honeypot only (ratatoskr up --profile full) ---
# CLOUDERA_AI_BASE_URL=
# CLOUDERA_JWT_TOKEN=
