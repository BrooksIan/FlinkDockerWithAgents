# Apemosyne — optional environment (copy to .env)
#
# Local dev: you can leave this file empty or copy with defaults below.
# Honeypot / LLM vars are only needed for the optional honeypot subproject.

# --- Control API (optional; start with: apemosyne api start) ---
# APEMOSYNE_API_HOST=127.0.0.1
# APEMOSYNE_API_PORT=8090
# Local dev: leave APEMOSYNE_API_KEY unset (all routes open).
# APEMOSYNE_API_KEY=

# --- Flink REST (API + CLI read JobManager here) ---
# FLINK_REST_ADDRESS=localhost
# FLINK_REST_PORT=8081

# --- Compose ---
# FLINK_AGENT_IMAGE=agent_flink_image:latest
# APEMOSYNE_PROFILE=minimal

# --- Honeypot only (apemosyne up --profile full) ---
# CLOUDERA_AI_BASE_URL=
# CLOUDERA_JWT_TOKEN=
